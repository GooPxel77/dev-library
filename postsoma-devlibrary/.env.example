# Built-in Vercel / Next.js AI planner (/api/plan)
# HTTPS API URL ending in /v1 (or full Chat Completions endpoint)
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Optional Upstash Redis REST credentials for persistent daily IP quota across Vercel instances.
# When omitted, /api/plan falls back to an in-memory per-instance counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional external /plan endpoint override (leave empty on Vercel to use built-in /api/plan)
NEXT_PUBLIC_AI_PLANNER_URL=

